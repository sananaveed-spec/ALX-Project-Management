# Copy to .env on the server (never commit real values):
#   cp .env.example .env
#
# For local dev, you can also copy to .env.local and run: npm run dev
#
# Rebuild the Docker image after changing any NEXT_PUBLIC_* value
# (they are baked into the client JS at build time).

NEXT_PUBLIC_AZURE_CLIENT_ID=your-application-client-id
NEXT_PUBLIC_AZURE_TENANT_ID=your-directory-tenant-id
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=allumiax.com
NEXT_PUBLIC_AZURE_AUTHORITY=https://login.microsoftonline.com/organizations

# --- Azure AD (portal steps, not env vars) ---
# App registration → Authentication → Single-page application
# Add redirect URI matching your public URL, e.g.:
#   https://projects.allumiax.com
# Local: http://localhost:5174
# Production example: https://projects.allumiax.com

# Where project JSON is stored (Docker default: /app/data)
DATA_DIR=./data

# --- Basecamp (server-only) ---
BASECAMP_ACCOUNT_ID=3700659
BASECAMP_CLIENT_ID=your-basecamp-client-id
BASECAMP_CLIENT_SECRET=your-basecamp-client-secret
BASECAMP_REDIRECT_URI=http://localhost:5174/api/basecamp/callback
BASECAMP_USER_AGENT=ALX Project Management (your-email@allumiax.com)
# Home-screen folder to file new projects into (per connected user)
BASECAMP_FOLDER_NAME=TestBySana

# --- Timesheets / ATS (SolidTime) — server-only ---
TIMESHEETS_API_TOKEN=your_api_token_here
TIMESHEETS_ORGANIZATION_ID=your_organization_id_here
TIMESHEETS_TIMEZONE=America/Los_Angeles
# Optional override (default: https://timesheets.allumiax.com/api/v1)
# TIMESHEETS_API_BASE_URL=https://timesheets.allumiax.com/api/v1
